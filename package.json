{
    "name": "simsuite",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@10.34.5",
    "type": "module",
    "description": "Local-first Sims content management suite built with Tauri, React, Rust, and SQLite.",
    "scripts": {
        "dev": "vite",
        "dev:cleanup": "node scripts/dev/prepare-dev-port.mjs",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "tauri:dev": "node scripts/dev/run-tauri-dev.mjs",
        "tauri:build": "node scripts/dev/run-tauri-build.mjs",
        "desktop:driver": "node scripts/desktop/run-powershell-script.mjs scripts/desktop/run-tauri-webdriver.ps1",
        "desktop:driver:fixtures": "node scripts/desktop/run-powershell-script.mjs scripts/desktop/run-tauri-webdriver.ps1 -UseSmokeFixtures",
        "desktop:smoke": "node scripts/desktop/desktop-smoke.mjs",
        "desktop:smoke:apply": "node scripts/desktop/desktop-smoke.mjs --include-apply",
        "desktop:smoke:fixtures": "node scripts/desktop/run-powershell-script.mjs scripts/desktop/run-tauri-smoke.ps1",
        "desktop:smoke:apply:fixtures": "node scripts/desktop/run-powershell-script.mjs scripts/desktop/run-tauri-smoke.ps1 -IncludeApply",
        "desktop:proof:fixtures": "node scripts/desktop/run-powershell-script.mjs scripts/desktop/run-desktop-library-proof.ps1",
        "desktop:proof:game-profile:windows": "node scripts/desktop/run-powershell-script.mjs scripts/desktop/run-windows-game-profile-proof.ps1",
        "test:dev-scripts": "node --test scripts/dev/dev-runtime.test.mjs",
        "test:unit": "node scripts/test/run-vitest.mjs && node --test scripts/dev/dev-runtime.test.mjs && node --test scripts/test/portable-helper-syntax.test.mjs",
        "test:rust": "node scripts/test/run-rust-tests.mjs",
        "test:library:stress": "node scripts/test/run-rust-tests.mjs large_ -- --ignored --nocapture"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.10.1",
        "lru-cache": "^5.1.1",
        "lucide-react": "^0.577.0",
        "motion": "^12.35.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@tanstack/react-virtual": "^3.13.24",
        "@tauri-apps/cli": "^2.10.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.4",
        "jsdom": "^29.0.0",
        "playwright": "^1.58.2",
        "screenshot-desktop": "^1.15.3",
        "selenium-webdriver": "^4.41.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.1.0"
    },
    "pnpm": {
        "overrides": {
            "@babel/helper-compilation-targets>lru-cache": "5.1.1"
        },
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
